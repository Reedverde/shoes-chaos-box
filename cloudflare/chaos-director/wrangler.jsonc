{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shoes-chaos-director",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
